{
  "name": "Vira-Theme-Anthracite",
  "type": "dark",
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "name": "Global settings",
      "settings": {
        "background": "#151719",
        "foreground": "#CCDBE3"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "foreground": "#C3E88D"
      }
    },
    {
      "name": "Punctuation",
      "scope": "punctuation, constant.other.symbol",
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
